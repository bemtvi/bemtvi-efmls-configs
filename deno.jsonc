{
  "tasks": {
    "gen": "deno run --allow-read=lua/efmls-configs --allow-write=doc/SUPPORTED_LIST.md,doc/supported-list.json generate.ts",
    // Regenerate the vimdoc help file (doc/efmls-configs.txt) from
