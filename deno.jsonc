{
  "tasks": {
    // Generate the supported-tools catalog, then canonicalize it through
    // `deno fmt` so the committed files match the generator exactly (keeps the
    // pre-push freshness check stable).
    "gen": "deno run --allow-read=lua/efmls-configs --allow-write=doc/SUPPORTED_LIST.md,doc/supported-list.json generate.ts && deno fmt doc/SUPPORTED_LIST.md doc/supported-list.json",
    // Regenerate the vimdoc help file (doc/efmls-configs.txt) from
    // doc/efmls-configs.md via panvimdoc. Needs pandoc + git on PATH.
    "doc": "bash scripts/gen-vimdoc.sh"
  },
  "fmt": {
    "lineWidth": 100
  }
}
